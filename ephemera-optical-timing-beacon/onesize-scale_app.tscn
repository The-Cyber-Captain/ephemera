[gd_scene format=3 uid="uid://m8v64rarmafk"]

[sub_resource type="GDScript" id="GDScript_4r165"]
resource_name = "BeaconManager"
script/source = "extends Control
@onready var marker_idx = %MarkerIdx
@onready var the_time = %TheTime
@onready var refresh_label = %RefreshLabel
@onready var fps_label = %FPSLabel

const NUM_OF_STATIONS = 240
const NUM_OF_STATIONS_X = 78
const STATION_MODULATION = Color(0.0, 0.1, 0.268, 1.0)

const MARK_SPACING = 24
const MARK_MODULATION = Color(0.535, 0.285, 0.0, 1.0)

@onready var top_row = %TopRow
@onready var left_pillar = %LeftPillar
@onready var right_pillar = %RightPillar
@onready var bottom_row = $BeaconFrame/BottomRow

var active_dot : Texture = preload(\"res://ActiveDot.png\")
var dormant_dot : Texture = preload(\"res://DormantDot.png\")

var texture_bank : Array[TextureRect]
 
var elapsed_ms := 0
var dot_index : int
var showing_dot_index : int = 0
var original_color : Color

var total_centisecs : int
var showing_centisecs : int = 0

func _ready():
	texture_bank.resize(NUM_OF_STATIONS)
	var num_of_stations_y = NUM_OF_STATIONS / 2 - NUM_OF_STATIONS_X
	var idx : int = 0
	
	for i : int in range(0, NUM_OF_STATIONS_X):
		texture_bank[idx] = top_row.get_child(i)
		idx += 1
	
	for i : int in range(0,num_of_stations_y):
		texture_bank[idx] = right_pillar.get_child(i)
		idx += 1
	
	for i : int in range(NUM_OF_STATIONS_X -1, -1, -1):
		texture_bank[idx] = bottom_row.get_child(i)
		idx += 1
	
	for i : int in range(num_of_stations_y -1, -1, -1):
		texture_bank[idx] = left_pillar.get_child(i)
		idx += 1
		
	for i : int in texture_bank.size():
		texture_bank[i].texture = dormant_dot
		var modulation_to_apply : Color
		if i % MARK_SPACING == 0:
			modulation_to_apply = MARK_MODULATION
		else:
			modulation_to_apply = STATION_MODULATION
		texture_bank[i].self_modulate = modulation_to_apply
	
	print(\"num of idx filled: %d\" % [idx])
	
	pass

func _process(_delta):
	elapsed_ms = Time.get_ticks_msec()
	dot_index = fmod((elapsed_ms / 1000.0 * NUM_OF_STATIONS),  NUM_OF_STATIONS)
	
	if dot_index != showing_dot_index:
		texture_bank[dot_index].texture = active_dot
		texture_bank[dot_index].self_modulate = Color.WHITE 
		texture_bank[showing_dot_index].texture = dormant_dot
		
		var modulation_to_apply : Color
		if showing_dot_index % MARK_SPACING == 0:
			modulation_to_apply = MARK_MODULATION
		else:
			modulation_to_apply = STATION_MODULATION
		texture_bank[showing_dot_index].self_modulate = modulation_to_apply
		showing_dot_index = dot_index

	
	total_centisecs = int(elapsed_ms / 10)
	if total_centisecs != showing_centisecs:
		the_time.text = format_centiseconds(total_centisecs)
		showing_centisecs = total_centisecs
		#pass
		
	marker_idx.text = \"Marker: %03d / %d\" % [dot_index, NUM_OF_STATIONS]


static func format_centiseconds(total_centiseconds: int) -> String:
	var centiseconds: int = total_centiseconds % 100

	var total_seconds: int = total_centiseconds / 100
	var seconds: int = total_seconds % 60

	var total_minutes: int = total_seconds / 60
	var minutes: int = total_minutes % 60

	var hours: int = total_minutes / 60

	return \"%02d:%02d:%02d.%02d\" % [
		hours,
		minutes,
		seconds,
		centiseconds,
	]

func _physics_process(_delta):
	refresh_label.text = \"Refresh rate: %d Hz\" % [DisplayServer.screen_get_refresh_rate()]
	fps_label.text = \"FPS: %s\" % [Engine.get_frames_per_second()]
#var elapsed_us := Time.get_ticks_usec() - epoch_ticks_usec
#var phase_us := elapsed_us % 1_000_000
#var dot_index := int(phase_us * 240 / 1_000_000)
"

[sub_resource type="GDScript" id="GDScript_p0cm1"]
resource_name = "QuitButton"
script/source = "extends Button


func _on_pressed():
	get_tree().quit()
"

[sub_resource type="GDScript" id="GDScript_boqyx"]
resource_name = "Pause"
script/source = "extends Button

func _on_toggled(toggled_on):
	get_tree().paused = toggled_on
"

